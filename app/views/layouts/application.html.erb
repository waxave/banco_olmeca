<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title>Banco Olmeca</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;500;800&family=Roboto:wght@300;400;900&display=swap" rel="stylesheet">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= image_path("logos/large.png") %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= image_path("logos/medium.png") %>">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= image_path("logos/small.png") %>">
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div class="min-h-full">
      <nav class="bg-[#43A4AB]">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <%= image_tag("logos/small.png", alt: "Banco Olmeca", class: 'h-8 w-8') %>
              </div>
              <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-4 font-['Raleway']">
                  <%= menu_link(root_path, t('operations.title')) %>
                  <%= menu_link(new_transfer_path, t('operations.kind.transfer')) %>
                  <%= menu_link(new_deposit_path, t('operations.kind.deposit')) %>
                  <%= menu_link(new_withdrawal_path, t('operations.kind.withdrawal')) %>
                </div>
              </div>
            </div>
            <div class="hidden md:block">
              <div class="ml-4 flex items-center md:ml-6">
                <div style="position:relative" data-controller="dropdown" data-action="click@document->dropdown#hide">
                  <button type="button"
                          data-action="dropdown#toggle"
                          class="flex items-center gap-2 rounded-md bg-[#43A4AB] border border-[#1A5B61] px-3 py-2 text-sm font-bold text-[#1A5B61] hover:bg-[#1A5B61] hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800">
                    <%= current_user.name %>
                    <svg class="h-3 w-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                    </svg>
                  </button>

                  <div data-dropdown-target="menu" style="position:absolute;right:0;top:100%;margin-top:0.5rem;display:none;z-index:50" class="bg-white border border-gray-200 rounded-md shadow-lg py-1 w-48">
                    <%= link_to edit_profile_path,
                                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" do %>
                      <%= t('profile.edit') %>
                    <% end %>

                    <%= link_to edit_password_path,
                                class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-200" do %>
                      <%= t('password.edit') %>
                    <% end %>

                    <div class="h-px bg-gray-200 my-1"></div>

                    <%= button_to session_path(current_user),
                                  method: :delete,
                                  data: { turbo: false },
                                  class: "block w-full text-left px-4 py-2 text-sm text-red-500 hover:bg-red-100" do %>
                      <%= t('common.logout') %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <header class="bg-white shadow">
        <div class="mx-auto max-w-7xl py-6 px-4 sm:px-6 lg:px-8">
          <h1 class="text-3xl font-bold tracking-tight text-gray-900 font-['Raleway']">
            <%= yield(:title) || t('operations.title') %>
          </h1>
        </div>
      </header>
      <main>
        <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
