<% provide(:title, t('operations.title')) %>
<% content_for :active_menu, root_path %>

<div class="grid grid-cols-4 gap-4">
  <div>
    <!-- Balance -->
    <%= render partial: "application/balance", locals: { balance: @current_user.read_attribute(:balance) } %>

    <!-- Cards -->
    <%= render partial: "application/card", collection: @current_user.cards, as: :card %>
  </div>

  <div class="col-span-3">
    <div class="bg-white p-8 rounded-md w-full">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-xl font-['Raleway'] text-gray-900 font-bold">
          <%= t('operations.title') %>
        </h1>
        <div class="text-sm text-gray-600 font-['Raleway']">
          <%= t('operations.total_operations', count: @operations.count) %>
        </div>
      </div>

      <!-- Lista de operaciones -->
      <%= render "operations/operations", operations: @operations %>
    </div>
  </div>
</div>
